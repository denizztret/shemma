{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run --cwd ${CLAUDE_PROJECT_DIR:-.}/packages/shemma-cli src/index.ts daemon ensure"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/draw-prehook.sh"
          }
        ]
      }
    ]
  }
}
